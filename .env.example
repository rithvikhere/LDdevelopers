# ==========================================
# [COMPANY NAME] — PLATFORM CONFIGURATION
# ==========================================

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Server-Side Secret Key (DO NOT EXPOSE IN CLIENT CODE)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Company Information Overrides (Optional)
NEXT_PUBLIC_COMPANY_NAME="[COMPANY NAME]"
NEXT_PUBLIC_WHATSAPP_PHONE="+[COUNTRY_CODE][PHONE_NUMBER]"
NEXT_PUBLIC_CONTACT_EMAIL="contact@companydomain.com"
